{
  "name": "web-presentation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cloudflare": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:math": "node scripts/audit-math.mjs",
    "audit:images": "node scripts/check-slide-images.mjs",
    "generate:plots": "python scripts/generate-regression-plots.py",
    "export:pdf": "node scripts/export-pdf.mjs",
    "export:pdf:dark": "PDF_THEME=dark node scripts/export-pdf.mjs",
    "export:images": "python3 scripts/export-slides-as-images.py",
    "export:images:from35": "python3 scripts/export-slides-as-images.py --start 35",
    "template:blank": "python3 scripts/create-blank-pptx-template.py",
    "audit:qa": "node scripts/prepublish-qa.mjs",
    "polish:content": "node scripts/prepublish-polish.mjs",
    "prepublish:check": "node scripts/prepublish-polish.mjs && npm run audit:content && npm run audit:math && npm run audit:qa && npm run audit:images && npm run build"
  },
  "dependencies": {
    "katex": "^0.16.45",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.52.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
